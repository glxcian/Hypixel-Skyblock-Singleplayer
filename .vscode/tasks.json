{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate VS Code launch configuration (Fabric Loom)",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": ["vscode"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Minecraft mod",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": ["clean", "build", "--no-daemon"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}